{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group non-major npm deps to cut PR noise",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "description": "Keep GitHub Actions minor/patch together",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github-actions non-major"
    },
    {
      "description": "Major Node / @types/node need a deliberate lockfile refresh",
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": true,
      "commitMessagePrefix": "fix(deps):"
    },
    {
      "description": "Group LLazyEmail/email-template-workflows Action updates and label them dependencies (no cross-repo CASCADE_TOKEN)",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "LLazyEmail/email-template-workflows",
        "llazyemail/email-template-workflows"
      ],
      "groupName": "email-template-workflows",
      "labels": ["dependencies"],
      "commitMessageTopic": "email-template-workflows",
      "additionalBranchPrefix": "action-"
    }
  ]
}
